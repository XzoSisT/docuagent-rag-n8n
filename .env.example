EMBEDDING_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
# Used by the FastAPI container to reach Ollama running on the host machine.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local uv runs use localhost; Docker Compose overrides this with http://qdrant:6333.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docuagent

TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
